# Copy to .env and fill in real values.
# These are read by `docker compose` from the project root.
# Never commit the real .env file.

POSTGRES_USER=idir
POSTGRES_PASSWORD=change-me
POSTGRES_DB=watchtower_db

# Docker-network connection string for the backend container.
# Keep the password URL-encoded (? = %3F). Host must be 'db'.
DATABASE_URL=postgres://idir:change-me%3F@db:5432/watchtower_db